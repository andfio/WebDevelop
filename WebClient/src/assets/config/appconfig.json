  "query": {
    "select": "SELECT Tab_Headers.ModelCode, SerialNumber, DummyCode, ProgramCode, ProgramDescription, UnitID, UnitTypeID, LineID, Shift, AbortCode, defects, Tab_RepairResults.RepairResult ",
    "from": "FROM Tab_Headers INNER JOIN Tab_Tests ON Tab_Headers.ID_Result = Tab_Tests.ID_Result LEFT JOIN Tab_RepairResults ON(Tab_Headers.ID_Result = Tab_RepairResults.ID_Res) ",
    "where": "WHERE ",
    "conditions": [
      { "filter": "Data Inizio", "sql": "AND Data >= @DataInizio" },
      { "filter": "Data Fine", "sql": "AND Data <= @DataFine" },      
      { "filter": "Model Code", "sql": "AND ModelCode = @ModelCode" },
      { "filter": "DummyCode", "sql": "AND SerialNumber = @SerialNumber" },
      { "filter": "Line", "sql": "AND LineID = @LineID" },
      { "filter": "Unit Type", "sql": "AND UnitTypeID = @UnitTypeID" },
      { "filter": "Unit", "sql": "AND UnitID = @UnitID" },
      { "filter": "Shift", "sql": "AND Shift = @Shift" },
      { "filter": "Abort Code", "sql": "AND AbortCode = @AbortCode" },
      { "filter": "Program Code", "sql": "AND ProgramCode = @ProgramCode" },
      { "filter": "Program Description", "sql": "AND ProgramDescription = @ProgramDescription" },
      { "filter": "Defect", "sql": "AND Tab_Tests.Defects = @Defects" },
      { "filter": "Fail Function", "sql": "AND Tab_Tests.FunctionCode = @FunctionCode" }
    ]
  }
}
