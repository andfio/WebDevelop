  "query": {
    "select": "SELECT DISTINCT TOP 1000 Tab_Headers.ID_Result, Tab_Headers.ModelCode, SerialNumber, DummyCode, ProgramCode, ProgramDescription, Date_Time, UnitID, UnitTypeID, LineID, Shift, Result, Tab_RepairResults.RepairResult ",
    "from": "FROM Tab_Headers INNER JOIN Tab_Tests ON Tab_Headers.ID_Result = Tab_Tests.ID_Result LEFT JOIN Tab_RepairResults ON(Tab_Headers.ID_Result = Tab_RepairResults.ID_Res) ",
    "where": "WHERE ",
    "conditions": [
      { "filter": "Start Date", "sql": "Date_Time >= @StartDate" },
      { "filter": "End Date", "sql": "AND Date_Time <= @EndDate" },      
      { "filter": "Model Code", "sql": "AND ModelCode LIKE @ModelCode" },
      { "filter": "DummyCode", "sql": "AND SerialNumber LIKE @DummyCode" },
      { "filter": "Line", "sql": "AND LineID LIKE @Line" },
      { "filter": "Unit Type", "sql": "AND UnitTypeID LIKE @UnitType" },
      { "filter": "Unit", "sql": "AND UnitID LIKE @Unit" },
      { "filter": "Shift", "sql": "AND Shift LIKE @Shift" },
	    { "filter": "Result", "sql": "AND Result LIKE @Result" },
      { "filter": "Abort Code", "sql": "AND AbortCode LIKE @AbortCode" },
      { "filter": "Program Code", "sql": "AND ProgramCode LIKE @ProgramCode" },
      { "filter": "Program Description", "sql": "AND ProgramDescription LIKE @ProgramDescription" },
      { "filter": "Defect", "sql": "AND Tab_Tests.Defects LIKE @Defect" },
      { "filter": "Fail Function", "sql": "AND Tab_Tests.FunctionCode LIKE @FailFunction" }
    ]
  },
    "querydetails": {
    "select": "SELECT Tab_Tests.ProgressiveGroup, Tab_Tests.TestType, StartEventTime, EndEventTime, TestResult, TestDescription, FunctionCode, Tab_Test_Details.Result, Descr, Params, Tab_Measures.ProgressiveMeasure, ErrorMeasure, MinSet, MaxSet, AnalogueValue, StoreName, MinLimit, MaxLimit ",
    "from": "FROM Tab_Tests LEFT JOIN Tab_Test_Details ON (Tab_Tests.ID_Result = Tab_Test_Details.ID_Result AND Tab_Tests.ProgressiveGroup = Tab_Test_Details.ProgressiveGroup) LEFT JOIN Tab_Measures ON (Tab_Tests.ID_Result = Tab_Measures.ID_Result AND Tab_Tests.ProgressiveGroup = Tab_Measures.ProgressiveGroup) ",
    "where": "WHERE ",
    "conditions": [
      { "filter": "ID", "sql": "ID_Result = @IDResult" }
    ]
  }
}
